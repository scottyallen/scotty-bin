#!/usr/bin/env python3
"""Switch between logged-in Claude Code accounts without re-authenticating.

Claude Code keeps its OAuth credentials in the macOS login keychain under the
generic-password service "Claude Code-credentials". Every running `claude`
session reads that single entry, so overwriting it swaps the account for all
sessions - they pick up the new token on their next refresh. That is the same
propagation you see after a manual re-login, but with no login.

This tool snapshots the live credential into named profiles (each stored as its
own keychain entry, so the secret tokens never touch disk) and swaps a saved
profile back in on demand. It also updates the human-readable identity in
~/.claude.json (oauthAccount) so the UI shows the right account immediately;
that field self-corrects from the API on the next profile fetch anyway, the
token is the real source of truth.

Alongside the CLI token, `save`/`switch` also snapshot and restore the claude.ai
browser login (the sessionKey cookie et al) so the Chrome session and the
Claude-in-Chrome extension follow the same account. Chrome caches cookies in
memory and never re-reads the on-disk jar while running, so a running Chrome is
swapped in place over the DevTools protocol and a stopped one by rewriting the
jar. Chrome is never quit or restarted - if it is running and DevTools can't be
reached, the browser swap fails and says so. Pass --no-browser to switch only
the CLI token and leave the browser alone.

Usage:
  claude-account list                 List saved profiles, mark the current one
  claude-account current              Show the currently logged-in account
  claude-account save <name>          Snapshot the live account into <name>
                                      (CLI token + claude.ai browser session;
                                       --browser-only skips the CLI token)
  claude-account switch <name>        Swap <name> in as the live account
                                      (--no-browser swaps only the CLI token
                                       and opens no DevTools connection, so it
                                       raises no Chrome consent dialog;
                                       --browser-only swaps only the browser)
  claude-account remove <name>        Delete a saved profile
  claude-account quota [<name>...]    Show usage quota for every saved profile
                                      (plus GLM/Z.ai and Kimi/Moonshot)
  claude-account help                 This help

`quota` reads each saved profile's token straight out of the keychain (the
active account's live one, the rest refreshed from their snapshot), so there is
no account list to maintain, and shows the GLM (Z.ai) plan and Kimi (Moonshot)
prepaid credit alongside the Claude Max buckets.

Typical one-time setup (each account only has to log in once, ever):
  # while logged in as your first account:
  claude-account save claude1
  # /login as your second account in Claude, then:
  claude-account save claude2
  # from then on, no more logins:
  claude-account switch claude1
"""

import base64
import getpass
import json
import os
import socket
import sqlite3
import struct
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

LIVE_SERVICE = "Claude Code-credentials"
PROFILE_SERVICE_PREFIX = "claude-account:"
# The claude.ai browser cookies for a profile are stored in their own keychain
# entry, separate from the CLI token above. They decrypt to the live session
# token with the machine's Chrome Safe Storage key, so they are just as secret
# as the CLI credential and belong in the keychain, not on disk.
BROWSER_SERVICE_PREFIX = "claude-account-browser:"
KEYCHAIN_ACCOUNT = getpass.getuser()  # Claude Code uses the OS username here.
META_DIR = os.path.expanduser("~/.config/pa/claude-accounts")
CLAUDE_JSON = os.path.expanduser("~/.claude.json")

# The Chrome profile whose cookie jar holds the claude.ai login. claude.ai is
# logged in per-browser-profile, independent of which Claude account it is, so
# swapping accounts means rewriting cookies inside one Chrome profile (the
# Default profile unless overridden). The env var lets a different profile dir
# (e.g. "Profile 2") be targeted without editing this file.
#
# It steers the on-disk path only. The CDP path reads and writes whatever
# cookie store the browser-level Storage.getCookies resolves to and never
# consults this, so with the var set to a non-default profile the two paths can
# disagree - the SQLite form describes the named profile while the CDP form
# describes whatever Chrome handed back. In practice that means the var is
# reliable for a stopped Chrome and unverified for a running one. profileDir is
# recorded in each snapshot but is not checked on restore.
CHROME_APP = "Google Chrome"
CHROME_PROFILE_DIR = os.environ.get("CLAUDE_ACCOUNT_CHROME_PROFILE", "Default")
CHROME_USER_DATA = os.path.expanduser(
    "~/Library/Application Support/Google/Chrome")
# The claude.ai cookies that together establish which account (and org) the
# browser and the Claude-in-Chrome extension act as. sessionKey is the auth
# token; the others keep the org/routing consistent so a swap doesn't leave a
# half-account state. We snapshot/restore this set as one coherent unit.
#
# "As one unit" is true of the capture but not quite of the restore: both
# restore paths only upsert (Storage.setCookies, INSERT OR REPLACE), neither
# deletes. A snapshot missing one of these names would therefore leave the
# outgoing account's copy of it behind. Only sessionKey is actually required at
# save time, so that is reachable in principle - though every snapshot observed
# so far carries all four, because claude.ai sets them together at login. Left
# as-is rather than half-fixed: deleting on the SQLite side is trivial, but the
# browser-level CDP target has no matching per-cookie delete, and a restore
# that prunes on one path and not the other is worse than one that prunes on
# neither.
BROWSER_COOKIE_NAMES = ("sessionKey", "sessionKeyLC", "lastActiveOrg",
                        "routingHint")
COOKIE_HOST = ".claude.ai"

