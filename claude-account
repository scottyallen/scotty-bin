# --- terminal color helpers -------------------------------------------------

def c(text, code):
  if not sys.stdout.isatty():
    return text
  return f"\033[{code}m{text}\033[0m"


def bold(t):
  return c(t, "1")


def green(t):
  return c(t, "32")


def yellow(t):
  return c(t, "33")


def red(t):
  return c(t, "31")


def dim(t):
  return c(t, "2")


def die(msg):
  print(red(f"error: {msg}"), file=sys.stderr)
  sys.exit(1)


# --- keychain access --------------------------------------------------------

def keychain_read(service):
  """Return the stored password blob for `service`, or None if absent."""
  result = subprocess.run(
      ["security", "find-generic-password", "-s", service,
       "-a", KEYCHAIN_ACCOUNT, "-w"],
      capture_output=True, text=True,
  )
  if result.returncode != 0:
    return None
  return result.stdout.rstrip("\n")


def keychain_write(service, blob):
  """Create or update the `service` keychain entry with `blob`."""
  # -U updates in place if the (service, account) entry already exists.
  # `security` has no way to read the secret from stdin/file, so it goes on the
  # argv. That is a sub-second exposure to `ps` on this single-user Mac only.
  result = subprocess.run(
      ["security", "add-generic-password", "-U",
       "-a", KEYCHAIN_ACCOUNT, "-s", service, "-w", blob],
      capture_output=True, text=True,
  )
  if result.returncode != 0:
    die(f"failed to write keychain entry {service!r}: {result.stderr.strip()}")


def keychain_delete(service):
  subprocess.run(
      ["security", "delete-generic-password", "-s", service,
       "-a", KEYCHAIN_ACCOUNT],
      capture_output=True, text=True,
  )


def profile_service(name):
  return PROFILE_SERVICE_PREFIX + name


def refresh_profile_token(name):
  """Exchange profile `name`'s refresh token for a fresh access token.

  A snapshot's access token dies about 8 hours after it was saved, which makes
  every non-active profile unprobeable. Claude Code itself refreshes only the
  live credential, so a profile you haven't switched to in a day is always
  stale. We do the same OAuth refresh the CLI does and write the result back
  into the profile, so the snapshot stays usable (and `switch` hands over a
  working token instead of one the API has already forgotten).

  Refresh tokens rotate on use, so the new blob MUST be persisted or the
  profile is bricked - the write is therefore the last thing that can fail.
  Returns (access_token, error).
  """
  blob = keychain_read(profile_service(name))
  if not blob:
    return None, "no stored credential"
  try:
    data = json.loads(blob)
  except ValueError:
    return None, "stored credential is not valid JSON"
  oauth = data.get("claudeAiOauth") or data
  refresh = oauth.get("refreshToken")
  if not refresh:
    return None, "stored credential has no refresh token"

  # A snapshot taken from the account that is still live shares its refresh
  # token with the live entry. Rotating it here would invalidate the token every
  # running `claude` session is holding and log them out, so borrow the live
  # access token instead - same account, and Claude Code keeps it fresh.
  if refresh == refresh_token_of(keychain_read(LIVE_SERVICE)):
    live_token = access_token(keychain_read(LIVE_SERVICE))
    if live_token:
      return live_token, ""

  payload = json.dumps({
      "grant_type": "refresh_token",
      "refresh_token": refresh,
      "client_id": OAUTH_CLIENT_ID,
  }).encode()
  req = urllib.request.Request(
      OAUTH_TOKEN_URL,
      data=payload,
      headers={"Content-Type": "application/json",
               "Accept": "application/json",
               # Without a claude-cli UA the endpoint 404s.
               "User-Agent": "claude-cli/2.0.0 (external, cli)"},
      method="POST",
  )
  try:
    with urllib.request.urlopen(req, timeout=15) as resp:
      body = json.loads(resp.read())
  except urllib.error.HTTPError as e:
    try:
      detail = json.loads(e.read())
      msg = detail.get("error_description") or detail.get("error") or ""
    except (ValueError, OSError, AttributeError):
      msg = ""
    return None, f"refresh failed (HTTP {e.code}{': ' + msg if msg else ''})"
  except urllib.error.URLError as e:
    return None, f"refresh failed: {e.reason}"
  except ValueError:
    return None, "refresh returned an unparseable response"

  token = body.get("access_token")
  if not token:
    return None, "refresh response had no access_token"
  oauth["accessToken"] = token
  if body.get("refresh_token"):
    oauth["refreshToken"] = body["refresh_token"]
  if body.get("expires_in"):
    oauth["expiresAt"] = int((time.time() + float(body["expires_in"])) * 1000)
  keychain_write(profile_service(name), json.dumps(data))
  return token, ""


def refresh_token_of(blob):
  """The refresh token inside a credential blob, or None."""
  if not blob:
    return None
  try:
    data = json.loads(blob)
  except ValueError:
    return None
  oauth = data.get("claudeAiOauth") or data
  token = oauth.get("refreshToken")
  return token if isinstance(token, str) and token else None


def token_expired(blob):
  """True if the blob's access token is past its expiry (or has none)."""
  try:
    data = json.loads(blob)
  except (ValueError, TypeError):
    return True
  oauth = data.get("claudeAiOauth") or data
  expires_at = oauth.get("expiresAt")
  if not expires_at:
    return False  # No expiry recorded - let the probe decide.
  return float(expires_at) / 1000.0 <= time.time()


def access_token(blob):
  """Pull the OAuth access token out of a stored credential blob.

  The blob is Claude Code's own keychain JSON: {"claudeAiOauth": {...}}. Older
  or hand-made entries have sometimes been flat, so accept that shape too.
  """
  if not blob:
    return None
  try:
    data = json.loads(blob)
  except ValueError:
    return None
  oauth = data.get("claudeAiOauth") or data
  token = oauth.get("accessToken")
  return token if isinstance(token, str) and token else None


# --- CDP: talk to a LIVE Chrome so a switch needs no restart -----------------
#
# Chrome caches cookies in memory and never re-reads the on-disk jar, so the
# SQLite path below can only be applied to a stopped Chrome. The DevTools
# protocol can set cookies (HttpOnly included) on a running browser instead.
# Chrome 136+ hardens off the /json HTTP endpoints on the default user-data-dir,
# but the browser-level WebSocket still works and Chrome publishes its URL in
# DevToolsActivePort - which is all we need. If remote debugging isn't enabled
# at all, cdp_connect() fails, and with a running Chrome that is the end of the
# road: the browser swap reports failure rather than closing the browser to get
# at the jar.

DEVTOOLS_PORT_FILE = os.path.join(CHROME_USER_DATA, "DevToolsActivePort")


class _WS:
  """Just enough RFC6455 to exchange JSON with Chrome (no third-party deps)."""

  def __init__(self, host, port, path):
    self.sock = socket.create_connection((host, port), timeout=10)
    key = base64.b64encode(os.urandom(16)).decode()
    # Deliberately no Origin header - Chrome rejects cross-origin DevTools
    # WebSockets unless --remote-allow-origins was passed, but accepts a
    # request that carries no Origin at all.
    req = (f"GET {path} HTTP/1.1\r\nHost: localhost:{port}\r\n"
           f"Upgrade: websocket\r\nConnection: Upgrade\r\n"
           f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
    self.sock.sendall(req.encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
      chunk = self.sock.recv(4096)
      if not chunk:
        raise OSError("connection closed during DevTools handshake")
      buf += chunk
    if "101" not in buf.split(b"\r\n", 1)[0].decode():
      raise OSError("DevTools WebSocket handshake refused")
    self._rest = buf.split(b"\r\n\r\n", 1)[1]
    self._id = 0

  def _recv_exact(self, n):
    out, self._rest = self._rest[:n], self._rest[n:]
    while len(out) < n:
      chunk = self.sock.recv(n - len(out))
      if not chunk:
        raise OSError("DevTools connection closed")
      out += chunk
    return out

  def _send(self, obj):
    payload = json.dumps(obj).encode()
    header = bytearray([0x81])  # FIN + text frame
    n = len(payload)
    if n < 126:
      header.append(0x80 | n)
    elif n < 65536:
      header.append(0x80 | 126)
      header += struct.pack(">H", n)
    else:
      header.append(0x80 | 127)
      header += struct.pack(">Q", n)
    mask = os.urandom(4)
    header += mask
    self.sock.sendall(bytes(header)
                      + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

  def call(self, method, params=None):
    """Send one command and pump messages until its reply comes back."""
    self._id += 1
    mid = self._id
    self._send({"id": mid, "method": method, "params": params or {}})
    while True:
      b0, b1 = self._recv_exact(2)
      opcode = b0 & 0x0F
      n = b1 & 0x7F
      if n == 126:
        n = struct.unpack(">H", self._recv_exact(2))[0]
      elif n == 127:
        n = struct.unpack(">Q", self._recv_exact(8))[0]
      payload = self._recv_exact(n)
      # Control frames aren't JSON. The realistic one here is a close frame
      # from a Chrome shutting down mid-switch; feeding its 2-byte status code
      # to json.loads would raise a ValueError that the callers' OSError
      # handlers miss, surfacing as a traceback after the CLI token has
      # already been swapped.
      if opcode == 0x8:
        raise OSError("DevTools closed the connection")
      if opcode in (0x9, 0xA):  # ping / pong
        continue
      msg = json.loads(payload)
      if msg.get("id") == mid:
        return msg

  def close(self):
    try:
      self.sock.close()
    except OSError:
      pass


def cdp_connect():
  """Connect to the running Chrome's browser target, or None if unavailable."""
  try:
    with open(DEVTOOLS_PORT_FILE) as f:
      port = int(f.readline().strip())
      path = f.readline().strip()
    if not path:
      return None
    return _WS("127.0.0.1", port, path)
  except (OSError, ValueError):
    return None


def cdp_get_identity_cookies(ws):
  """The claude.ai identity cookies as CDP cookie dicts, from live memory.

  Reading through Chrome rather than the jar also sidesteps the flush delay:
  a cookie set seconds ago (a fresh login) is in memory but not yet on disk.
  """
  result = ws.call("Storage.getCookies").get("result", {})
  out = []
  for ck in result.get("cookies", []):
    if ck.get("domain", "").endswith("claude.ai") \
        and ck.get("name") in BROWSER_COOKIE_NAMES:
      keep = {k: ck[k] for k in
              ("name", "value", "domain", "path", "secure", "httpOnly")
              if k in ck}
      if ck.get("sameSite"):
        keep["sameSite"] = ck["sameSite"]
      # -1 marks a session cookie; passing it back through would be rejected.
      if ck.get("expires", -1) and ck.get("expires", -1) > 0:
        keep["expires"] = ck["expires"]
      out.append(keep)
  return out


def cdp_set_cookies(ws, cookies):
  """Install cookies into the live browser. Returns True on success."""
  reply = ws.call("Storage.setCookies", {"cookies": cookies})
  return "error" not in reply


# --- browser session (claude.ai cookies) ------------------------------------

def browser_service(name):
  return BROWSER_SERVICE_PREFIX + name


def cookie_db_path():
  """Path to the Cookies SQLite jar for the targeted Chrome profile."""
  return os.path.join(CHROME_USER_DATA, CHROME_PROFILE_DIR, "Cookies")


def chrome_is_running():
  return subprocess.run(["pgrep", "-x", CHROME_APP],
                        capture_output=True).returncode == 0


# There is deliberately no quit_chrome()/launch_chrome() here. An earlier
# version quit a running Chrome so it could rewrite the on-disk cookie jar, then
# relaunched it - which closed every open tab and killed any in-flight
# claude-in-chrome session for the sake of a cookie swap. Restoring that
# behaviour is not a fix for a failing switch; re-saving the profile against a
# live browser is (see browser_switch).


def _cookie_columns(con):
  return [r[1] for r in con.execute("PRAGMA table_info(cookies)")]


def read_browser_cookies():
  """Read the claude.ai identity cookies out of the live jar.

  Returns a list of full rows (every column, encrypted_value base64'd so the
  snapshot is JSON/keychain-storable), or None if the jar is missing/unreadable.
  Copies the DB to a temp file before opening it so a running Chrome's lock
  doesn't block the read - this is only used at `save` time, when Chrome may
  still be up.
  """
  src = cookie_db_path()
  if not os.path.isfile(src):
    return None
  fd, tmp = tempfile.mkstemp(prefix="cc-cookies.")
  os.close(fd)
  try:
    # -wal/-shm may hold unflushed rows; copying just the main file is fine for
    # our cookies, which are persistent and long-since flushed.
    #
    # A failed copy leaves an empty temp file, which sqlite happily opens as a
    # valid but schemaless database - so without this check the failure surfaces
    # much later as a ValueError from cols.index() rather than as the None this
    # function promises.
    if subprocess.run(["cp", src, tmp], capture_output=True).returncode != 0:
      return None
    con = sqlite3.connect(tmp)
    try:
      cols = _cookie_columns(con)
      ev = cols.index("encrypted_value")
      q = (f"SELECT {','.join(cols)} FROM cookies "
           f"WHERE host_key=? AND name IN "
           f"({','.join('?' * len(BROWSER_COOKIE_NAMES))})")
      rows = []
      for r in con.execute(q, (COOKIE_HOST, *BROWSER_COOKIE_NAMES)):
        d = dict(zip(cols, r))
        d["encrypted_value"] = base64.b64encode(bytes(r[ev])).decode()
        rows.append(d)
      return rows
    finally:
      con.close()
  except (sqlite3.Error, ValueError):
    # ValueError covers a jar whose `cookies` table lacks the columns we index
    # by name - a schemaless copy, or a future Chrome that renamed them.
    return None
  finally:
    try:
      os.unlink(tmp)
    except OSError:
      pass


def write_browser_cookies(rows):
  """Upsert saved cookie rows back into the live jar. Chrome MUST be quit."""
  db = cookie_db_path()
  con = sqlite3.connect(db)
  try:
    live_cols = set(_cookie_columns(con))
    for d in rows:
      d = dict(d)
      d["encrypted_value"] = base64.b64decode(d["encrypted_value"])
      # Only set columns the current schema still has, so a Chrome that added a
      # column since the snapshot doesn't break the insert.
      use = [c for c in d if c in live_cols]
      placeholders = ",".join("?" * len(use))
      con.execute(
          f"INSERT OR REPLACE INTO cookies ({','.join(use)}) "
          f"VALUES ({placeholders})", [d[c] for c in use])
    con.commit()
  finally:
    con.close()


def has_session_key(cookies):
  """True when this capture carries a sessionKey, i.e. an actual session.

  Works for either form: the CDP dicts and the SQLite row dicts both key the
  cookie name under "name". A capture without a sessionKey is not a session -
  a logged-out browser still returns lastActiveOrg and routingHint - so storing
  one over a good snapshot would lose the account while looking like a save.
  """
  return any(c.get("name") == "sessionKey" for c in cookies or ())


def jar_matches_other_profile(name, rows):
  """The profile whose saved sessionKey the jar's row matches, or None.

  Only a positive match means anything. Chrome's cookie encryption here is
  deterministic, so identical plaintext gives identical ciphertext and a match
  is proof the jar belongs to that other account - but a jar matching nothing
  saved may still be the right account with a session that has since rotated,
  so no match is not evidence of correctness. Compares base64 as stored; never
  decrypts, so it never touches the Chrome Safe Storage keychain entry (reading
  that pops a blocking GUI auth prompt).
  """
  jar_key = next((r.get("encrypted_value") for r in rows
                  if r.get("name") == "sessionKey"), None)
  if not jar_key:
    return None
  for other in list_profile_names():
    if other == name:
      continue
    for r in (read_browser_snapshot(other) or {}).get("sqlite") or []:
      if r.get("name") == "sessionKey" and r.get("encrypted_value") == jar_key:
        return other
  return None


def browser_snapshot(name, quiet=False, expected_org=None, cdp_cookies=None):
  """Capture the live claude.ai browser session into profile `name`.

  Captures both representations when it can: the CDP form (plaintext cookies,
  read from Chrome's memory) drives the no-restart switch, and the SQLite form
  (raw encrypted rows) is the fallback for when DevTools isn't reachable. Either
  alone is enough to restore.

  `cdp_cookies` lets a caller hand in a CDP form it read earlier. browser_switch
  passes the cookies it read over its own connection, so snapshotting the
  outgoing account costs no second connection - and therefore no second Chrome
  "Allow remote debugging?" dialog.

  Best-effort: if Chrome isn't set up or isn't logged into claude.ai, we warn and
  move on rather than failing the whole save - the CLI token is the primary
  artifact.
  """
  # Build on the stored snapshot rather than a bare dict, and replace a form
  # only when this capture actually produced one. The two forms are obtainable
  # under different conditions - the CDP form needs a running, logged-in Chrome;
  # the SQLite form needs a readable jar - so a capture that gets one of them
  # must leave the other alone. Writing a freshly-built payload instead deletes
  # whichever form was unavailable, and `save <name>` with Chrome closed would
  # then strip the CDP form and report success: the exact ratchet this file
  # exists to prevent, reachable from the documented setup command.
  #
  # The cost is that a preserved form can be older than the one just captured.
  # That trade is deliberate. Losing a form is certain damage on an ordinary
  # command; staleness is conditional (the session has to have rotated) and is
  # corrected by the next capture that can see that form.
  payload = read_browser_snapshot(name) or {}
  payload.pop("cookies", None)  # legacy key; read_browser_snapshot maps it
  payload.update({"savedAt": int(time.time()),
                  "profileDir": CHROME_PROFILE_DIR})

  if cdp_cookies is not None:
    captured = cdp_cookies
  else:
    captured = None
    ws = cdp_connect()
    if ws:
      try:
        captured = cdp_get_identity_cookies(ws)
      except OSError:
        pass
      finally:
        ws.close()

  # Which forms this capture actually refreshed. Empty means nothing was
  # learned, so the stored entry is left exactly as it was.
  fresh = []
  problem = None

  if has_session_key(captured):
    # When DevTools gave us plaintext we can tell which account the browser is
    # actually logged into. Refuse to overwrite a saved session with a different
    # account's - the same class of mistake the CLI guard in snapshot() blocks.
    live_org = next((c["value"] for c in captured
                     if c["name"] == "lastActiveOrg"), None)
    if expected_org and live_org and live_org != expected_org:
      # Always printed, even when `quiet` silences the success line: this one
      # tells the user to log claude.ai into a different account, which no
      # generic "not snapshotted" note would convey.
      print(yellow(f"note: the browser is logged into org {live_org}, not "
                   f"{name}'s org {expected_org}; browser session NOT saved "
                   f"(log claude.ai into the right account first)"))
      return False
    payload["cdp"] = captured
    fresh.append("live browser")
  elif captured is not None:
    problem = (f"Chrome is running but has no claude.ai sessionKey (logged "
               f"out); {name}'s stored session is unchanged")

  rows = read_browser_cookies()
  if has_session_key(rows):
    # The org guard above can only run when DevTools handed us plaintext. With
    # Chrome stopped there is no CDP form, and the jar's values are Safe-Storage
    # encrypted, so the account behind them can't be read directly. A byte
    # comparison still catches the common case: Chrome's cookie encryption here
    # is deterministic, so the same session yields the same ciphertext, and a
    # jar whose sessionKey matches a DIFFERENT profile's saved one demonstrably
    # isn't this account's.
    owner = jar_matches_other_profile(name, rows)
    if owner:
      # Only the jar is in doubt. A CDP form that passed the org check above is
      # positive proof of the account, so skip these rows and keep going rather
      # than discarding a capture that was already validated. Reachable through
      # the flush delay: right after a live swap the jar can still hold the
      # previous account's rows.
      print(yellow(f"note: the on-disk cookie jar holds {owner}'s session, not "
                   f"{name}'s; keeping {name}'s stored jar rows (a previous "
                   f"`switch --no-browser` leaves the browser on another "
                   f"account)"))
    else:
      payload["sqlite"] = rows
      fresh.append("on-disk jar")

  if not fresh:
    if problem is None:
      problem = (f"no claude.ai sessionKey available for {name} - Chrome isn't "
                 f"running or DevTools is unreachable, and the on-disk jar had "
                 f"none either")
    print(yellow(f"note: {problem}"))
    return False

  keychain_write(browser_service(name), json.dumps(payload))
  if not quiet:
    names = {c["name"] for c in payload.get("cdp", [])} \
        | {r["name"] for r in payload.get("sqlite", [])}
    print(green("saved") + f" browser session for {bold(name)} "
          f"({len(names)} cookies via {' + '.join(fresh)})")
  return True


def read_browser_snapshot(name):
  """Return the saved snapshot dict for `name`, or None if absent/corrupt.

  Normalizes the pre-CDP format, which stored the SQLite rows under "cookies".
  """
  blob = keychain_read(browser_service(name))
  if not blob:
    return None
  try:
    snap = json.loads(blob)
  except ValueError:
    return None
  if "cookies" in snap and "sqlite" not in snap:
    snap["sqlite"] = snap["cookies"]
  return snap


def outgoing_org(outgoing):
  """The organizationUuid profile `outgoing` is supposed to be logged into."""
  return ((read_meta(outgoing) or {}).get("oauthAccount") or {}).get(
      "organizationUuid")


def browser_switch(name, outgoing):
  """Swap the browser to profile `name`'s claude.ai session.

  Two paths, and neither one ever closes a window you have open:

    Chrome running     - swap the cookies in place over DevTools.
    Chrome not running - rewrite the on-disk jar, which is only safe (and only
                         possible) with nothing holding the SQLite lock.

  This tool used to bridge the gap by quitting a running Chrome, rewriting the
  jar, and relaunching. It no longer does, at all: killing the browser takes
  every open tab and any in-flight claude-in-chrome session with it, which is a
  worse outcome than a switch that declines to happen. So a running Chrome that
  DevTools can't reach is now a hard failure with instructions, not a restart.

  Returns True on a completed swap.
  """
  snap = read_browser_snapshot(name)
  if not snap:
    print(yellow(f"note: no saved browser session for {name!r} - the browser "
                 f"was left as-is. Save one with: claude-account save {name}"))
    return False

  # --- Chrome running: swap in place over DevTools, no restart ---
  if chrome_is_running():
    if not snap.get("cdp"):
      print(red(f"error: profile {name!r} has no live-swappable cookie "
                f"snapshot, and the only other way to install one is a write "
                f"to the on-disk jar that a running Chrome would ignore. "
                f"Browser session unchanged."))
      print(dim(f"  fix: quit Chrome and re-run, or - once claude.ai is "
                f"logged into {name} - run: "
                f"claude-account save {name} --browser-only"))
      return False

    ws = cdp_connect()
    if not ws:
      print(red("error: Chrome is running but its DevTools endpoint is "
                "unreachable, so the session can't be swapped in place. "
                "Browser session unchanged."))
      print(dim("  fix: retry (this endpoint is intermittent), or quit Chrome "
                "and re-run to take the on-disk path."))
      return False

    try:
      # Preserve the outgoing account's freshest cookies first - reading from
      # memory means we catch a session that rotated since the last save.
      #
      # Hand them to browser_snapshot() rather than writing the keychain here.
      # It owns every guard a snapshot needs (it must carry a sessionKey, and
      # its org must match the profile's), and an inlined copy of the write
      # silently loses them: an empty read from a logged-out browser would
      # overwrite a good CDP form with [] and still report success - the very
      # ratchet this file exists to avoid.
      if outgoing and outgoing != name:
        if browser_snapshot(outgoing, quiet=True,
                            expected_org=outgoing_org(outgoing),
                            cdp_cookies=cdp_get_identity_cookies(ws)):
          print(dim(f"(snapshotted outgoing browser session -> {outgoing})"))
        # No generic note on failure: browser_snapshot() prints the specific
        # reason itself, and the four reasons imply four different fixes.

      if cdp_set_cookies(ws, snap["cdp"]):
        print(green("switched") + f" browser session to {bold(name)}"
              + dim(" (live, no restart)"))
        return True
      print(red("error: DevTools refused the cookie write; browser session "
                "unchanged."))
      return False
    except (OSError, ValueError) as e:
      # ValueError catches a malformed DevTools reply (json.loads); without it
      # the traceback would escape after the CLI token was already swapped.
      print(red(f"error: DevTools connection failed ({e}); browser session "
                f"unchanged."))
      return False
    finally:
      ws.close()

  # --- Chrome not running: rewrite the on-disk jar directly ---
  if not snap.get("sqlite"):
    print(red(f"error: profile {name!r} has no on-disk cookie snapshot, and "
              f"the live path needs a running Chrome. Browser session "
              f"unchanged."))
    print(dim(f"  fix: start Chrome, log claude.ai into {name}, then: "
              f"claude-account save {name} --browser-only"))
    return False

  # Preserve the outgoing account's cookies before we overwrite them. No CDP
  # form is obtainable here - nothing is running to read one from - so this
  # refreshes only the SQLite half. The stored CDP form is left as it was
  # rather than dropped, so a switch with Chrome closed costs the outgoing
  # profile nothing; that is the merge in browser_snapshot(), and it is what
  # keeps this path off the ratchet.
  #
  # The account behind those rows can't be read (they're encrypted), so this
  # snapshot is verified only as far as jar_matches_other_profile() can reach:
  # a jar holding some other profile's known session is caught, a jar holding
  # an account we have never saved is not.
  if outgoing and outgoing != name:
    if browser_snapshot(outgoing, quiet=True,
                        expected_org=outgoing_org(outgoing)):
      print(dim(f"(snapshotted outgoing browser session -> {outgoing})"))
    # browser_snapshot() explains its own failures - see the live path above.

  try:
    write_browser_cookies(snap["sqlite"])
  except sqlite3.Error as e:
    print(red(f"error: failed to write Chrome cookie jar: {e}"))
    return False

  print(green("switched") + f" browser session to {bold(name)}"
        + dim(" (Chrome was not running)"))
  return True


# --- ~/.claude.json identity ------------------------------------------------

def read_claude_json():
  try:
    with open(CLAUDE_JSON) as f:
      return json.load(f)
  except (OSError, ValueError):
    return {}


def current_oauth_account():
  """The oauthAccount object from ~/.claude.json (identity, not secret)."""
  return read_claude_json().get("oauthAccount") or {}


def write_oauth_account(oauth_account):
  """Atomically replace only the oauthAccount key in ~/.claude.json.

  Claude Code writes this file often; we read the freshest copy, swap one key,
  and rename a temp file over it so we never leave a half-written file. A
  concurrent Claude write could still be lost, but the fields there are cosmetic
  and self-heal on the next profile fetch.
  """
  data = read_claude_json()
  if not data:
    # Don't create a bogus ~/.claude.json from nothing.
    return False
  data["oauthAccount"] = oauth_account
  d = os.path.dirname(CLAUDE_JSON)
  fd, tmp = tempfile.mkstemp(dir=d, prefix=".claude.json.")
  try:
    with os.fdopen(fd, "w") as f:
      json.dump(data, f, indent=2)
    os.replace(tmp, CLAUDE_JSON)
  except OSError as e:
    try:
      os.unlink(tmp)
    except OSError:
      pass
    die(f"failed to update {CLAUDE_JSON}: {e}")
  return True


# --- profile metadata (non-secret) ------------------------------------------

def meta_path(name):
  return os.path.join(META_DIR, name + ".json")


def read_meta(name):
  try:
    with open(meta_path(name)) as f:
      return json.load(f)
  except (OSError, ValueError):
    return None


def write_meta(name, meta):
  os.makedirs(META_DIR, exist_ok=True)
  path = meta_path(name)
  fd, tmp = tempfile.mkstemp(dir=META_DIR, prefix="." + name + ".")
  with os.fdopen(fd, "w") as f:
    json.dump(meta, f, indent=2)
  os.replace(tmp, path)
  os.chmod(path, 0o600)


def list_profile_names():
  if not os.path.isdir(META_DIR):
    return []
  names = []
  for fn in os.listdir(META_DIR):
    if fn.endswith(".json") and not fn.startswith("."):
      names.append(fn[:-len(".json")])
  return sorted(names)


def account_label(oauth_account):
  """Short human label for an oauthAccount identity."""
  email = oauth_account.get("emailAddress") or "unknown"
  return email


def find_profile_for_uuid(account_uuid):
  """Return the profile name whose saved identity matches account_uuid."""
  if not account_uuid:
    return None
  for name in list_profile_names():
    meta = read_meta(name)
    if meta and meta.get("accountUuid") == account_uuid:
      return name
  return None


# --- quota: Anthropic ---------------------------------------------------------

def probe_quota(token, model=PROBE_MODEL):
  """Make a minimal API call to get rate limit headers.

  Returns (headers, error). Exactly one is meaningful.
  """
  data = json.dumps({
      "model": model,
      "max_tokens": 1,
      # Premium models reject an OAuth token that doesn't look like the CLI,
      # and that rejection carries no rate limit headers at all.
      "system": [{
          "type": "text",
          "text": "You are Claude Code, Anthropic's official CLI for Claude.",
      }],
      "messages": [{"role": "user", "content": "x"}],
  }).encode()
  req = urllib.request.Request(
      API_URL,
      data=data,
      headers={
          "Authorization": f"Bearer {token}",
          "anthropic-version": "2023-06-01",
          "anthropic-beta": "oauth-2025-04-20,claude-code-20250219",
          "user-agent": "claude-cli/2.0.0 (external, cli)",
          "x-app": "cli",
          "Content-Type": "application/json",
      },
      method="POST",
  )
  try:
    with urllib.request.urlopen(req, timeout=15) as resp:
      return {k.lower(): v for k, v in resp.headers.items()}, ""
  except urllib.error.HTTPError as e:
    headers = {k.lower(): v for k, v in e.headers.items()}
    # 429 still returns rate limit headers.
    if any("ratelimit" in k for k in headers):
      return headers, ""
    try:
      message = json.loads(e.read()).get("error", {}).get("message", "")
    except (ValueError, OSError):
      message = ""
    return None, f"HTTP {e.code}: {message or e.reason}"
  except urllib.error.URLError as e:
    return None, f"connection failed: {e.reason}"


def format_time_until(reset_epoch):
  delta = reset_epoch - time.time()
  if delta <= 0:
    return "now"
  hours = int(delta // 3600)
  minutes = int((delta % 3600) // 60)
  if hours > 24:
    days = hours // 24
    hours = hours % 24
    return f"{days}d {hours}h"
  if hours > 0:
    return f"{hours}h {minutes}m"
  return f"{minutes}m"


def format_bar(utilization, width=20):
  # Clamp rather than trust the input. Over 1.0 the padding count goes negative
  # and contributes nothing, so the bar grows past `width` and every column
  # after it on that line shifts - the one thing a fixed-width bar exists to
  # prevent. Whether either backend can report over 100% is unconfirmed, which
  # is the reason to clamp: it costs nothing and does not depend on the answer.
  filled = max(0, min(width, int(utilization * width)))
  bar = "█" * filled + "░" * (width - filled)
  if utilization >= 0.9:
    return red(bar)
  if utilization >= 0.7:
    return yellow(bar)
  return green(bar)


def quota_line(label, used, reset_epoch, extra=""):
  # Pad so every bucket line in every backend's block starts at one column.
  suffix = f"  {extra}" if extra else ""
  # Floor at zero for the same reason format_bar clamps: over 100% used, the
  # unclamped form prints "-30.0% remaining", which reads as a measurement
  # rather than the "nothing left" it actually means.
  remaining = min(1.0, max(0.0, 1.0 - used)) * 100
  print(f"    {label + ':':<14}{format_bar(used)} {remaining:5.1f}% remaining"
        f"  resets in {format_time_until(reset_epoch)}{suffix}")


def render_account_quota(name, token, is_current):
  """Probe one Claude account and print its 5h / 7d / Fable buckets."""
  marker = green(" *") if is_current else ""
  headers, error = probe_quota(token)
  # A Fable probe can fail on its own (exhausted premium quota, model
  # unavailable) while the account is otherwise fine. Fall back to Haiku so the
  # 5h/7d numbers still show up.
  if not headers:
    headers, error = probe_quota(token, FALLBACK_MODEL)
  if not headers:
    print(f"  {bold(name)}{marker}: {red(error)}")
    if "401" in error or "authentication" in error.lower():
      print(dim(f"    stored token may be stale - refresh it with: "
                f"claude-account save {name}"))
    print()
    return

  def bucket(prefix):
    util = headers.get(f"anthropic-ratelimit-unified-{prefix}-utilization")
    if util is None:
      return None
    return (float(util),
            float(headers.get(f"anthropic-ratelimit-unified-{prefix}-reset", 0)),
            headers.get(f"anthropic-ratelimit-unified-{prefix}-status", "?"))

  session = bucket("5h")
  weekly = bucket("7d")
  fable = bucket("7d_oi")

  statuses = [b[2] for b in (session, weekly, fable) if b]
  status_icon = ""
  if "rejected" in statuses:
    status_icon = " " + red("(RATE LIMITED)")
  elif "allowed_warning" in statuses:
    status_icon = " " + yellow("(warning)")

  print(f"  {bold(name)}{marker}{status_icon}")
  for label, b in (("Session (5h)", session), ("Weekly  (7d)", weekly)):
    if b:
      quota_line(label, b[0], b[1])
  if fable:
    quota_line("Fable   (7d)", fable[0], fable[1])
  else:
    print(f"    {'Fable   (7d):':<14}{dim('(unavailable)')}")
  print()


# --- quota: GLM (Z.ai) --------------------------------------------------------

def load_secret(key):
  """Read `key` from the same secrets.env the `glm` and `kimi` launchers source.

  Returns None if the file or key is absent so the rest of the output still
  renders.
  """
  if not os.path.isfile(SECRETS_ENV):
    return None
  try:
    with open(SECRETS_ENV) as f:
      for raw in f:
        line = raw.strip()
        if line.startswith("export "):
          line = line[len("export "):].strip()
        if line.startswith(key + "="):
          val = line[len(key) + 1:].strip()
          if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            val = val[1:-1]
          return val
  except OSError:
    return None
  return None


def http_get_json(url, api_key):
  """GET a JSON endpoint with a bearer token. Returns (payload, error)."""
  req = urllib.request.Request(
      url,
      headers={"Authorization": f"Bearer {api_key}", "Accept": "application/json"},
      method="GET",
  )
  try:
    with urllib.request.urlopen(req, timeout=15) as resp:
      return json.loads(resp.read()), ""
  except urllib.error.HTTPError as e:
    try:
      body = json.loads(e.read())
      msg = body.get("msg") or body.get("error", {}).get("message", "")
    except (ValueError, OSError, AttributeError):
      msg = ""
    return None, msg or f"HTTP {e.code}"
  except urllib.error.URLError as e:
    return None, f"connection failed: {e.reason}"
  except ValueError:
    return None, "unparseable response"


def _glm_window_label(reset_epoch_s):
  """Bucket a quota window's reset time into a 5h/7d/30d label."""
  delta = reset_epoch_s - time.time()
  if delta < 0:
    return "?"
  if delta < 1.5 * 86400:
    return "5h"
  if delta < 10 * 86400:
    return "7d"
  if delta < 45 * 86400:
    return "30d"
  return "long"


# 12-char labels so the GLM block lines up with the Claude Max Session/Weekly
# lines. Value is (label, display order).
_GLM_LABEL_BY_WINDOW = {
    "5h": ("Session (5h)", 0),
    "7d": ("Weekly  (7d)", 1),
    "30d": ("Tools  (30d)", 2),
}


def render_glm():
  """Print the Z.ai (GLM) Coding Plan quota block."""
  api_key = load_secret("ZAI_API_KEY")
  if not api_key:
    print(f"  {bold('glm')}: {dim('(ZAI_API_KEY not set in ' + SECRETS_ENV + ')')}")
    print()
    return

  payload, error = http_get_json(ZAI_QUOTA_URL, api_key)
  if payload and not payload.get("success"):
    payload, error = None, payload.get("msg", "request failed")
  if not payload:
    print(f"  {bold('glm')}: {red(error)}")
    print()
    return
  data = payload.get("data") or {}

  rows = []  # (sort_key, label, used_fraction, reset_s, extra_or_None)
  max_used = 0.0
  for lim in data.get("limits", []):
    pct_used = float(lim.get("percentage", 0))
    reset_s = float(lim.get("nextResetTime", 0)) / 1000.0
    window = _glm_window_label(reset_s)
    label, sort_key = _GLM_LABEL_BY_WINDOW.get(window, (None, 99))
    if label is None:
      label = f"Tokens ({window})"
    extra = None
    if lim.get("type") == "TIME_LIMIT":
      # On the tools limit `usage` is the cap and `currentValue` is consumed.
      cap = float(lim.get("usage", 0))
      used_n = float(lim.get("currentValue", 0))
      extra = f"{int(used_n)}/{int(cap)} used"
    rows.append((sort_key, label, pct_used / 100.0, reset_s, extra))
    max_used = max(max_used, pct_used / 100.0)

  status_icon = ""
  if max_used >= 1.0:
    status_icon = " " + red("(RATE LIMITED)")
  elif max_used >= 0.9:
    status_icon = " " + yellow("(warning)")

  print(f"  {bold('glm')} {dim('(z.ai · ' + str(data.get('level', '?')) + ' plan)')}"
        f"{status_icon}")
  for _, label, used, reset_s, extra in sorted(rows, key=lambda r: r[0]):
    quota_line(label, used, reset_s, extra or "")
  print()


