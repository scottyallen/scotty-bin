# --- commands ---------------------------------------------------------------

def snapshot(name, quiet=False, force=False, with_browser=True):
  """Capture the live keychain credential + identity into profile `name`.

  Refuses when the live account isn't the one `name` already refers to. The live
  credential is shared by every running `claude` session, and any of them can
  swap it back on a token refresh - so "the live account" is not necessarily the
  one you last switched to. Without this guard, a `save` issued at the wrong
  moment silently overwrites a profile's token with a different account's and
  destroys the only copy (that is exactly how claude2 was lost on 2026-07-23).
  """
  blob = keychain_read(LIVE_SERVICE)
  if not blob:
    die("no live Claude credential found in the keychain - is `claude` "
        "logged in? Run /login first.")
  oauth = current_oauth_account()
  existing = read_meta(name)
  if (not force and existing and existing.get("accountUuid")
      and oauth.get("accountUuid")
      and existing["accountUuid"] != oauth.get("accountUuid")):
    die(f"refusing to overwrite profile {name!r}: it holds "
        f"{existing.get('email') or existing['accountUuid']} but the live "
        f"account is {account_label(oauth)}.\n"
        f"  The live account may have been swapped back by another running "
        f"session. Check with: claude-account current\n"
        f"  If you really mean to repoint {name!r} at "
        f"{account_label(oauth)}, re-run with --force.")
  keychain_write(profile_service(name), blob)
  meta = {
      "label": name,
      "email": oauth.get("emailAddress"),
      "accountUuid": oauth.get("accountUuid"),
      "organizationName": oauth.get("organizationName"),
      "organizationType": oauth.get("organizationType"),
      "oauthAccount": oauth,
      "savedAt": int(time.time()),
  }
  write_meta(name, meta)
  if not quiet:
    who = account_label(oauth)
    print(green(f"saved") + f" profile {bold(name)} <- {who}")
  # Also capture the claude.ai browser login so `switch` can restore it. Best
  # effort - a missing/unauth'd browser never blocks saving the CLI token.
  #
  # Callers pass with_browser=False when they must not touch CDP: every
  # connection costs the user a Chrome "Allow remote debugging?" dialog, and
  # Chrome refuses to persist that approval (chrome-devtools-mcp#825, closed as
  # not planned). Keep this to at most one connection per command.
  if with_browser:
    browser_snapshot(name, quiet=quiet,
                     expected_org=oauth.get("organizationUuid"))


def cmd_save(args):
  force = "--force" in args
  browser_only = "--browser-only" in args
  names = [a for a in args if a not in ("--force", "--browser-only")]
  if len(names) != 1:
    die("usage: claude-account save <name> [--force] [--browser-only]")
  name = names[0]
  if browser_only:
    # Re-capture only the claude.ai session, leaving the stored CLI token
    # alone. Two uses, neither of them repairing a strip - browser_snapshot()
    # only ever replaces a form with a capture that produced its own
    # sessionKey, so a form can no longer be lost:
    #   - seeding a CDP form on a profile whose saves have all happened with
    #     Chrome closed, so it only ever got the SQLite half;
    #   - refreshing a form the merge deliberately kept in a stale state (the
    #     trade recorded on browser_snapshot's payload) once a browser that
    #     can see it is available.
    meta = read_meta(name)
    if meta is None:
      avail = ", ".join(list_profile_names()) or "(none)"
      die(f"no saved profile {name!r}. Available: {avail}")
    org = (meta.get("oauthAccount") or {}).get("organizationUuid")
    # Same reasoning as `switch --browser-only`: the snapshot is the whole
    # command, so a refused one is a failed command. A plain `save` stays
    # best-effort about the browser half - the CLI token is what it's for.
    return 0 if browser_snapshot(name, expected_org=org) else 1
  snapshot(name, force=force)
  return 0


def cmd_switch(args):
  # --no-browser swaps only the CLI token; --browser-only swaps only the
  # browser session. They ask for opposite halves, so passing both is a
  # contradiction rather than a combination.
  do_browser = "--no-browser" not in args
  browser_only = "--browser-only" in args
  if browser_only and not do_browser:
    die("--no-browser and --browser-only are contradictory; pass one or "
        "neither")
  positional = [a for a in args
                if a not in ("--no-browser", "--browser-only")]
  if len(positional) != 1:
    die("usage: claude-account switch <name> [--no-browser | --browser-only]")
  name = positional[0]
  if read_meta(name) is None:
    avail = ", ".join(list_profile_names()) or "(none)"
    die(f"no saved profile {name!r}. Available: {avail}")

  # The outgoing account, used to re-snapshot its freshest CLI token and browser
  # session before we overwrite them.
  current = current_oauth_account()
  outgoing = find_profile_for_uuid(current.get("accountUuid"))

  if browser_only:
    # The browser swap is the whole command here, so its failure is the
    # command's failure.
    return 0 if browser_switch(name, outgoing) else 1

  target_blob = keychain_read(profile_service(name))
  if not target_blob:
    die(f"profile {name!r} has metadata but no stored credential in the "
        f"keychain. Re-run: claude-account save {name}")

  # Refresh the outgoing account's snapshot first so its latest (possibly
  # just-rotated) tokens are preserved before we overwrite the live entry.
  #
  # Deliberately CLI-token-only. Each CDP connection costs a Chrome "Allow
  # remote debugging?" dialog, so the whole command gets at most one: when
  # do_browser is set, browser_switch() below snapshots the outgoing browser
  # session itself (and applies the wrong-account guard while it's connected);
  # when it isn't, --no-browser means leave the browser strictly alone.
  if outgoing and outgoing != name:
    snapshot(outgoing, quiet=True, with_browser=False)
    print(dim(f"(snapshotted outgoing account -> {outgoing})"))
  elif not outgoing and current.get("accountUuid"):
    print(yellow(f"note: the current account ({account_label(current)}) isn't "
                 f"saved as a profile; its refreshed tokens won't be kept. "
                 f"Save it first with: claude-account save <name>"))

  # Swap the live credential, then update the cosmetic identity to match.
  keychain_write(LIVE_SERVICE, target_blob)
  meta = read_meta(name)
  if meta and meta.get("oauthAccount"):
    write_oauth_account(meta["oauthAccount"])

  who = account_label(meta.get("oauthAccount", {})) if meta else name
  print(green("switched") + f" to {bold(name)} ({who})")
  print(dim("Running sessions pick this up on their next token refresh; open a "
            "new session for it to take effect immediately."))

  # Follow the CLI swap with the browser session so Chrome and the
  # Claude-in-Chrome extension act as the same account. A failure here leaves
  # the CLI swapped and the browser not, so report it - the token swap above
  # has already happened and is not rolled back.
  if do_browser and not browser_switch(name, outgoing):
    return 1
  return 0


def cmd_remove(args):
  if len(args) != 1:
    die("usage: claude-account remove <name>")
  name = args[0]
  if read_meta(name) is None and keychain_read(profile_service(name)) is None:
    die(f"no such profile {name!r}")
  keychain_delete(profile_service(name))
  keychain_delete(browser_service(name))
  try:
    os.unlink(meta_path(name))
  except OSError:
    pass
  print(green("removed") + f" profile {bold(name)}")


def cmd_current(args):
  oauth = current_oauth_account()
  if not oauth:
    print("current account: " + yellow("unknown (no oauthAccount in "
                                        "~/.claude.json)"))
    return
  who = account_label(oauth)
  match = find_profile_for_uuid(oauth.get("accountUuid"))
  tag = f" [{bold(match)}]" if match else dim(" (not saved as a profile)")
  print(f"current account: {bold(who)}{tag}")
  org = oauth.get("organizationName")
  if org:
    print(dim(f"  org: {org}  ({oauth.get('organizationType', '')})"))


def cmd_list(args):
  names = list_profile_names()
  if not names:
    print("no saved profiles yet. Save the current account with:")
    print("  " + bold("claude-account save <name>"))
    return
  current_uuid = current_oauth_account().get("accountUuid")
  print(bold("Saved Claude accounts:"))
  for name in names:
    meta = read_meta(name) or {}
    is_current = meta.get("accountUuid") and meta["accountUuid"] == current_uuid
    marker = green(" * ") if is_current else "   "
    email = meta.get("email") or "unknown"
    saved = meta.get("savedAt")
    when = ""
    if saved:
      age_days = (time.time() - saved) / 86400
      when = dim(f"  (saved {age_days:.0f}d ago)")
    has_cred = keychain_read(profile_service(name)) is not None
    warn = "" if has_cred else red("  [MISSING credential - re-save]")
    browser = green("  +browser") if read_browser_snapshot(name) else ""
    label = bold(name) if is_current else name
    print(f"{marker}{label:<12} {email}{when}{browser}{warn}")
  print()
  print(dim("  * = currently active    switch with: "
            "claude-account switch <name>"))


def cmd_quota(args):
  """Show remaining usage for every saved profile plus the other backends.

  Tokens come straight from the keychain, so this covers whatever profiles are
  saved with no separate account list to keep in sync. The active account is
  probed with the live credential (the freshest token); the rest use their last
  snapshot, which the API keeps honoring well past its nominal expiry.
  """
  names = list_profile_names()
  if args:
    unknown = [a for a in args if a not in names]
    if unknown:
      die(f"no saved profile(s): {', '.join(unknown)}. "
          f"Available: {', '.join(names) or '(none)'}")
    names = args

  current_uuid = current_oauth_account().get("accountUuid")
  print()
  if not names:
    print("  " + yellow("no saved Claude profiles - save one with: "
                        "claude-account save <name>"))
    print()
  for name in names:
    meta = read_meta(name) or {}
    is_current = bool(current_uuid) and meta.get("accountUuid") == current_uuid
    # The active account's live entry is kept fresh by Claude Code itself;
    # a parked profile's snapshot has to be refreshed here before it will probe.
    if is_current:
      token, refresh_error = access_token(keychain_read(LIVE_SERVICE)), ""
    else:
      blob = keychain_read(profile_service(name))
      token = access_token(blob)
      refresh_error = ""
      if not token or token_expired(blob):
        token, refresh_error = refresh_profile_token(name)
    if not token:
      detail = refresh_error or "no usable credential in the keychain"
      print(f"  {bold(name)}: {red(detail)}")
      # Once the refresh token is gone there is nothing left to renew from, so
      # this profile genuinely needs one interactive login to re-seed.
      print(dim(f"    re-seed it: /login as this account in Claude, then "
                f"claude-account save {name}"))
      print()
      continue
    render_account_quota(name, token, is_current)

  render_glm()
  render_kimi()
  if names:
    print(dim("  * = currently active Claude account"))
    print()


def cmd_help(args):
  print(__doc__)


COMMANDS = {
    "list": cmd_list,
    "ls": cmd_list,
    "current": cmd_current,
    "whoami": cmd_current,
    "save": cmd_save,
    "switch": cmd_switch,
    "use": cmd_switch,
    "sw": cmd_switch,
    "remove": cmd_remove,
    "rm": cmd_remove,
    "delete": cmd_remove,
    "quota": cmd_quota,
    "usage": cmd_quota,
    "help": cmd_help,
    "-h": cmd_help,
    "--help": cmd_help,
}


def main(argv):
  """Run a subcommand. Returns the process exit status (0 = success).

  Handlers return non-zero when the thing they were asked to do did not
  happen. That matters for the browser swap in particular: it can fail while
  the CLI token swap succeeded, and a wrapper or `&&` chain reading exit 0
  would take a half-applied switch for a complete one.
  """
  if not argv:
    cmd_list([])
    return 0
  cmd = argv[0]
  handler = COMMANDS.get(cmd)
  if not handler:
    die(f"unknown command {cmd!r}. Try: claude-account help")
  return handler(argv[1:]) or 0


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
